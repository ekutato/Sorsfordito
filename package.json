{
  "name": "penzugyi-sorsfordito",
  "version": "0.1.0",
  "private": true,
  "description": "Penzugyi Sorsfordito - Financial literacy simulation game with real Hungarian economic data",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
